{
  "$id": "https://workforce.local/protocols/v0.1/project-progress-projection.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "minLength": 1,
            "type": "string"
          },
          "versionId": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "versionId"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "empty": {
      "type": "boolean"
    },
    "emptyDisplay": {
      "const": "还没有记录",
      "type": "string"
    },
    "events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "runId": {
            "minLength": 1,
            "type": "string"
          },
          "taskId": {
            "minLength": 1,
            "type": "string"
          },
          "time": {
            "format": "date-time",
            "type": "string"
          },
          "type": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "time"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "generatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "projectId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "runs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "taskId": {
            "minLength": 1,
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "taskId",
          "status",
          "updatedAt"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "tasks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "updatedAt"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "projectId",
    "generatedAt",
    "empty",
    "tasks",
    "runs",
    "events",
    "artifacts"
  ],
  "title": "ProjectProgressProjectionDto",
  "type": "object"
}
