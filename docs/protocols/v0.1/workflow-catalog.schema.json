{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workforce.local/protocols/v0.1/workflow-catalog.schema.json",
  "title": "WorkflowCatalog",
  "description": "P1 read-only published workflow template catalog. Not an executable Runtime graph and not a canvas editor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "protocolVersion",
    "status",
    "activeVersionId",
    "versions"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "protocolVersion": { "type": "string", "const": "0.1" },
    "status": { "type": "string", "const": "published" },
    "activeVersionId": { "type": "string", "minLength": 1 },
    "versions": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflowVersion" }
    }
  },
  "$defs": {
    "workflowVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workflowId", "version", "status", "immutable", "entry", "steps"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "workflowId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "const": "published" },
        "immutable": { "type": "boolean", "const": true },
        "entry": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/workflowStep" }
        }
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["task", "delivery", "approval"] },
        "title": { "type": "string", "minLength": 1 },
        "worker": { "type": "string", "minLength": 1 },
        "gate": { "type": "string", "enum": ["plan", "artifact"] },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
