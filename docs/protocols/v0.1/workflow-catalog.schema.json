{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workforce.local/protocols/v0.1/workflow-catalog.schema.json",
  "title": "WorkflowCatalog",
  "description": "WorkflowDefinition / WorkflowVersion catalog. GET list is published-only. Draft graphs use the same nodes/edges protocol as published versions. Unpublished versions are not executable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "protocolVersion", "status", "versions"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "protocolVersion": { "type": "string", "const": "0.1" },
    "status": { "type": "string", "enum": ["draft", "published"] },
    "activeVersionId": { "type": "string", "minLength": 1 },
    "stateRevision": { "type": "integer", "minimum": 1 },
    "definitionRevision": { "type": "integer", "minimum": 1 },
    "versions": {
      "type": "array",
      "items": { "$ref": "#/$defs/workflowVersion" }
    }
  },
  "$defs": {
    "workflowVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workflowId", "version", "status", "immutable"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "workflowId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "immutable": { "type": "boolean" },
        "entry": { "type": "string", "minLength": 1 },
        "stateRevision": { "type": "integer", "minimum": 1 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/workflowStep" }
        },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/workflowGraphNode" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/workflowGraphEdge" }
        }
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "notes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["task", "delivery", "approval"] },
        "title": { "type": "string", "minLength": 1 },
        "worker": { "type": "string", "minLength": 1 },
        "gate": { "type": "string", "enum": ["plan", "artifact"] },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "workflowGraphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["task", "approval", "condition", "parallel"] },
        "title": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["planner", "developer", "reviewer", "approver"] },
        "joinPolicy": { "type": "string", "enum": ["all_success", "all_terminal", "min_success"] },
        "minSuccess": { "type": "integer", "minimum": 1 },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "maxReworkCycles": { "type": "integer", "minimum": 0 },
        "requiresReview": { "type": "boolean" },
        "expectedOutputIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100 },
        "conditionKey": { "type": "string", "minLength": 1 },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value"],
            "properties": {
              "value": { "type": "string", "minLength": 1 },
              "isDefault": { "type": "boolean" }
            }
          }
        }
      }
    },
    "workflowGraphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "waitFor": {
          "type": "string",
          "enum": ["outputs_ready", "completed", "failed", "cancelled", "any_terminal"]
        },
        "conditionValue": { "type": "string", "minLength": 1 },
        "inputBindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slotId", "fromOutputId"],
            "properties": {
              "slotId": { "type": "string", "minLength": 1 },
              "fromOutputId": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
