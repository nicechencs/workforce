{
  "$id": "https://workforce.local/protocols/v0.1/task.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "type": "integer"
    },
    "cancelRequested": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string"
    },
    "definitionRevision": {
      "type": "integer"
    },
    "dependsOn": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "taskId": {
            "minLength": 1,
            "type": "string"
          },
          "waitFor": {
            "enum": [
              "outputs_ready",
              "completed"
            ],
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "waitFor"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "generation": {
      "type": "integer"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "projectId": {
      "minLength": 1,
      "type": "string"
    },
    "protocolVersion": {
      "const": "0.1",
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "stateRevision": {
      "type": "integer"
    },
    "status": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "workflowNodeId": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "projectId",
    "title",
    "objective",
    "status",
    "stateRevision",
    "definitionRevision",
    "generation",
    "attempt",
    "protocolVersion",
    "cancelRequested",
    "createdAt",
    "updatedAt",
    "dependsOn"
  ],
  "title": "TaskDto",
  "type": "object"
}
