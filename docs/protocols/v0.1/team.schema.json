{
  "$id": "https://workforce.local/protocols/v0.1/team.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activeVersionId": {
      "minLength": 1,
      "type": "string"
    },
    "definitionRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "protocolVersion": {
      "const": "0.1",
      "type": "string"
    },
    "roles": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "role",
          "version"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "stateRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ],
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "versions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "immutable": {
            "type": "boolean"
          },
          "members": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "quantity": {
                  "minimum": 1,
                  "type": "integer"
                },
                "role": {
                  "minLength": 1,
                  "type": "string"
                },
                "runtimeProfileId": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "role",
                "runtimeProfileId",
                "quantity"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "publishedAt": {
            "format": "date-time",
            "type": "string"
          },
          "stateRevision": {
            "minimum": 1,
            "type": "integer"
          },
          "status": {
            "enum": [
              "draft",
              "published"
            ],
            "type": "string"
          },
          "teamId": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "teamId",
          "version",
          "status",
          "immutable",
          "members"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "status",
    "protocolVersion",
    "roles"
  ],
  "title": "Team",
  "type": "object"
}
