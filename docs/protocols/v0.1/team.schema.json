{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workforce.local/protocols/v0.1/team.schema.json",
  "title": "Team",
  "description": "Team / TeamVersion catalog. GET list is published-only (preset + custom). Unpublished TeamVersion cannot bind :start-planning.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "status", "protocolVersion", "roles"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "published"] },
    "protocolVersion": { "type": "string", "const": "0.1" },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "version"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "activeVersionId": { "type": "string", "minLength": 1 },
    "stateRevision": { "type": "integer", "minimum": 1 },
    "definitionRevision": { "type": "integer", "minimum": 1 },
    "versions": {
      "type": "array",
      "items": { "$ref": "#/$defs/teamVersion" }
    }
  },
  "$defs": {
    "teamVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "teamId", "version", "status", "immutable", "members"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "teamId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "immutable": { "type": "boolean" },
        "stateRevision": { "type": "integer", "minimum": 1 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "runtimeProfileId", "quantity"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "runtimeProfileId": { "type": "string", "minLength": 1 },
              "quantity": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
