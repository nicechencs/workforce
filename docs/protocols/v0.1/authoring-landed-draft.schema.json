{
  "$id": "https://workforce.local/protocols/v0.1/authoring-landed-draft.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "landed",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "unpublished": {
      "const": true,
      "type": "boolean"
    },
    "workerDraftId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "workflowDraftId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "workflowId": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "kind",
    "unpublished"
  ],
  "title": "AuthoringLandedDraft",
  "type": "object"
}
