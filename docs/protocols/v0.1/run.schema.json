{
  "$id": "https://workforce.local/protocols/v0.1/run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "type": "integer"
    },
    "cancelRequested": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string"
    },
    "definitionRevision": {
      "type": "integer"
    },
    "executionSnapshotId": {
      "minLength": 1,
      "type": "string"
    },
    "generation": {
      "type": "integer"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "orchestrationMode": {
      "enum": [
        "workflow_bound",
        "direct"
      ],
      "type": "string"
    },
    "projectId": {
      "minLength": 1,
      "type": "string"
    },
    "protocolVersion": {
      "const": "0.1",
      "type": "string"
    },
    "stateRevision": {
      "type": "integer"
    },
    "status": {
      "type": "string"
    },
    "taskId": {
      "minLength": 1,
      "type": "string"
    },
    "transport": {
      "enum": [
        "process",
        "sdk",
        "http"
      ],
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "usage": {
      "additionalProperties": false,
      "properties": {
        "costMinor": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "unknown",
            "estimated",
            "settled"
          ],
          "type": "string"
        }
      },
      "required": [
        "costMinor",
        "currency",
        "kind"
      ],
      "type": "object"
    }
  },
  "required": [
    "id",
    "taskId",
    "projectId",
    "status",
    "stateRevision",
    "definitionRevision",
    "generation",
    "attempt",
    "protocolVersion",
    "cancelRequested",
    "usage",
    "createdAt",
    "updatedAt"
  ],
  "title": "RunDto",
  "type": "object"
}
