{
  "$id": "https://workforce.local/protocols/v0.1/money.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "costMinor": {
      "type": "integer"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "unknown",
        "estimated",
        "settled"
      ],
      "type": "string"
    }
  },
  "required": [
    "costMinor",
    "currency"
  ],
  "title": "Money",
  "type": "object"
}
