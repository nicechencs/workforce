{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workforce.local/protocols/v0.1/authoring-session.schema.json",
  "title": "AuthoringSession",
  "description": "D17 conversational authoring session and unpublished draft projection. Executable source is packages/protocol AuthoringSessionDto / AuthoringDraftDto. Not a Runtime, Task, or Run. Not a chat HTTP path. T20 send stays disabled until a follow-up wires this DTO. Old name executionMode is not accepted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectId",
    "protocolVersion",
    "status",
    "messages",
    "stateRevision",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "protocolVersion": { "type": "string", "const": "0.1" },
    "status": { "type": "string", "enum": ["open", "failed", "closed"] },
    "messages": {
      "type": "array",
      "items": { "$ref": "#/$defs/authoringSessionMessage" }
    },
    "draft": { "$ref": "#/$defs/authoringDraft" },
    "stateRevision": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "authoringSessionMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "content", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["user", "system", "authoring_agent"] },
        "content": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "authoringDraft": {
      "oneOf": [
        { "$ref": "#/$defs/authoringDraftProposal" },
        { "$ref": "#/$defs/authoringDraftLanded" }
      ]
    },
    "authoringDraftProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "unpublished"],
      "properties": {
        "kind": { "type": "string", "const": "proposal" },
        "unpublished": { "type": "boolean", "const": true },
        "workflow": { "$ref": "#/$defs/authoringDraftWorkflowProposal" },
        "team": { "$ref": "#/$defs/authoringDraftTeamProposal" }
      },
      "anyOf": [{ "required": ["workflow"] }, { "required": ["team"] }]
    },
    "authoringDraftLanded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "unpublished", "workflowId", "workflowVersionId"],
      "properties": {
        "kind": { "type": "string", "const": "landed" },
        "unpublished": { "type": "boolean", "const": true },
        "workflowId": { "type": "string", "minLength": 1 },
        "workflowVersionId": { "type": "string", "minLength": 1 },
        "teamId": { "type": "string", "minLength": 1 },
        "teamVersionId": { "type": "string", "minLength": 1 }
      }
    },
    "authoringDraftWorkflowProposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "entry": { "type": "string", "minLength": 1 },
            "steps": {
              "type": "array",
              "items": { "$ref": "workflow-catalog.schema.json#/$defs/workflowStep" }
            },
            "nodes": {
              "type": "array",
              "items": { "$ref": "workflow-catalog.schema.json#/$defs/workflowGraphNode" }
            },
            "edges": {
              "type": "array",
              "items": { "$ref": "workflow-catalog.schema.json#/$defs/workflowGraphEdge" }
            }
          }
        }
      }
    },
    "authoringDraftTeamProposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "runtimeProfileId", "quantity"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "runtimeProfileId": { "type": "string", "minLength": 1 },
              "quantity": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
