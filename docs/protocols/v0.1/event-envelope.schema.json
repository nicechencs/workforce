{
  "$id": "https://workforce.local/protocols/v0.1/event-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "additionalProperties": false,
      "properties": {
        "adapterVersion": {
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "enum": [
            "user",
            "worker",
            "runtime",
            "service",
            "system"
          ],
          "type": "string"
        },
        "workerVersionId": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    "causationId": {
      "type": "string"
    },
    "correlationId": {
      "minLength": 1,
      "type": "string"
    },
    "data": {
      "additionalProperties": {},
      "type": "object"
    },
    "dataContentType": {
      "const": "application/json",
      "type": "string"
    },
    "dataSchema": {
      "minLength": 1,
      "type": "string"
    },
    "extensions": {
      "additionalProperties": {},
      "type": "object"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "ingestionPosition": {
      "minimum": 1,
      "type": "integer"
    },
    "organizationId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "recordedAt": {
      "format": "date-time",
      "type": "string"
    },
    "redaction": {
      "additionalProperties": {},
      "type": "object"
    },
    "runId": {
      "type": "string"
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "source": {
      "minLength": 1,
      "type": "string"
    },
    "specVersion": {
      "const": "0.1",
      "type": "string"
    },
    "stream": {
      "minLength": 1,
      "type": "string"
    },
    "subject": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "type": "object"
    },
    "taskId": {
      "type": "string"
    },
    "time": {
      "format": "date-time",
      "type": "string"
    },
    "trace": {
      "additionalProperties": false,
      "properties": {
        "spanId": {
          "type": "string"
        },
        "traceId": {
          "type": "string"
        }
      },
      "required": [
        "traceId"
      ],
      "type": "object"
    },
    "type": {
      "pattern": "^[a-z][a-z0-9_.]*[a-z0-9]$",
      "type": "string"
    },
    "workflowInstanceId": {
      "type": "string"
    }
  },
  "required": [
    "specVersion",
    "id",
    "type",
    "source",
    "subject",
    "time",
    "recordedAt",
    "actor",
    "stream",
    "correlationId",
    "dataContentType",
    "dataSchema",
    "data",
    "sensitivity"
  ],
  "title": "WorkforceEvent",
  "type": "object"
}
