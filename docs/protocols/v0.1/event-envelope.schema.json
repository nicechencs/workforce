{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workforce.local/protocols/v0.1/event-envelope.schema.json",
  "title": "WorkforceEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "id",
    "type",
    "source",
    "subject",
    "time",
    "recordedAt",
    "actor",
    "stream",
    "correlationId",
    "dataContentType",
    "dataSchema",
    "data",
    "sensitivity"
  ],
  "properties": {
    "specVersion": { "const": "0.1" },
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]*[a-z0-9]$"
    },
    "source": { "type": "string", "minLength": 1 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "time": { "type": "string", "format": "date-time" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "organizationId": { "type": "string" },
    "projectId": { "type": "string" },
    "workflowInstanceId": { "type": "string" },
    "taskId": { "type": "string" },
    "runId": { "type": "string" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["user", "worker", "runtime", "service", "system"]
        },
        "id": { "type": "string", "minLength": 1 },
        "workerVersionId": { "type": "string" },
        "adapterVersion": { "type": "string" }
      }
    },
    "sequence": { "type": "integer", "minimum": 1 },
    "stream": { "type": "string", "minLength": 1 },
    "ingestionPosition": { "type": "integer", "minimum": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": "string" },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId"],
      "properties": {
        "traceId": { "type": "string" },
        "spanId": { "type": "string" }
      }
    },
    "dataContentType": { "const": "application/json" },
    "dataSchema": { "type": "string", "minLength": 1 },
    "data": { "type": "object" },
    "sensitivity": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "restricted"]
    },
    "redaction": { "type": "object" },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
