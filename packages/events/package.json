{
  "name": "@workforce/events",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    },
    "./store": {
      "types": "./src/store/index.ts",
      "default": "./src/store/index.ts"
    },
    "./outbox": {
      "types": "./src/outbox/index.ts",
      "default": "./src/outbox/index.ts"
    },
    "./subscriptions": {
      "types": "./src/subscriptions/index.ts",
      "default": "./src/subscriptions/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workforce/domain": "workspace:*",
    "@workforce/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
